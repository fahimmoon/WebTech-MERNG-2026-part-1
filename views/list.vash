<table border="1" cellpadding="5" cellspacing="0">
    <tr>
        <th>Reg No</th>
        <th>Name</th>
        @model.heads.forEach(function(head){
            <th style="text-align:center">
                @head.headname<br/>
                <hr/>
                @head.total
            </th>
        })
        <th>Total</th>
        <th>%</th>
        <th>Grade</th>
    </tr>
    @model.students.forEach(function(student){
        <tr data-regno="@student.regno">
            <td><a href="javascript:void(0)" onclick="editMarks('@student.regno')">@student.regno</a></td>
            <td><a href="javascript:void(0)" onclick="editMarks('@student.regno')">@student.name</a></td>
            @model.heads.forEach(function(head){
                <td style="text-align:center">
                    @(student.marks_map && student.marks_map['h' + head.hid] != null ? student.marks_map['h' + head.hid].toFixed(2) : '0.00')
                </td>
            })
            <td class="total-marks">@student.total.toFixed(2)</td>
            <td>@Math.round(student.total)</td>
            <td class="grade">@(student.grade || 'N/A')</td>
        </tr>
    })
</table>

<div id="edit-modal" style="display:none; position:fixed; top:15%; left:50%; transform:translateX(-50%); background:white; border:1px solid #ccc; padding:15px; z-index:100; min-width: 350px; box-shadow: 0 0 20px rgba(0,0,0,0.3);">
    <table border="1" style="width:100%; border-collapse: collapse;">
        <tr>
            <th style="text-align:left; padding:5px; background:#f9f9f9;">Reg. No</th>
            <td style="padding:5px;"><span id="modal-regno"></span></td>
        </tr>
        <tr>
            <th style="text-align:left; padding:5px; background:#f9f9f9;">Name</th>
            <td style="padding:5px;"><span id="modal-name"></span></td>
        </tr>
    </table>
    
    <table border="1" style="width:100%; border-collapse: collapse; margin-top:10px;" id="marks-table">
        <tbody id="marks-inputs"></tbody>
    </table>
    
    <div style="text-align: right; margin-top: 15px;">
        <button onclick="saveMarks()" style="padding: 5px 15px; cursor: pointer;">Save</button>
        <button onclick="closeModal()" style="padding: 5px 15px; cursor: pointer; margin-left:10px;">Cancel</button>
    </div>
</div>
<div id="overlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:99;" onclick="closeModal()"></div>